# ── Frontend (Vite) ─────────────────────────────────────────────
# Flask API URL — omit or leave empty to run in localStorage demo mode
VITE_API_URL=http://localhost:5000

# Supabase — browser anon key only (never service_role)
# Get from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Optional ──────────────────────────────────────────────────────
# VLY integrations (if used) — injected automatically by Vly platform
# VLY_INTEGRATION_KEY=
# VLY_INTEGRATION_BASE_URL=https://integrations.vly.ai/

